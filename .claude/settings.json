{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cochem_host_guard.py\"",
            "timeout": 15,
            "statusMessage": "CoChem host guard"
          }
        ]
      }
    ]
  }
}
